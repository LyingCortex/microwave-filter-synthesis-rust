{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "filter-bench unified report",
  "description": "所有后端 (python / mfs / rust-native) 输出共用。跨语言 diff / 跨机对比 / CI 消费的唯一契约。",
  "type": "object",
  "required": ["schema_version", "contract_version", "harness", "results"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contract_version": { "type": "string" },
    "harness": {
      "type": "object",
      "required": ["backend", "language", "platform"],
      "properties": {
        "backend": { "type": "string" },
        "language": { "type": "string" },
        "platform": { "type": "string" },
        "cpu": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case", "gates", "stages"],
        "properties": {
          "case": { "type": "string", "description": "全局 id: <family>_<id>" },
          "status": { "enum": ["PASS", "FAIL", "SKIP"] },
          "gates": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["status"],
              "properties": {
                "status": { "enum": ["PASS", "FAIL", "SKIP"] },
                "metric": { "type": ["number", "null"] },
                "tol": { "type": ["number", "null"] },
                "detail": { "type": ["string", "null"] }
              }
            }
          },
          "stages": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["median_ms"],
              "properties": {
                "median_ms": { "type": "number" },
                "p95_ms": { "type": ["number", "null"] },
                "min_ms": { "type": ["number", "null"] },
                "n": { "type": ["integer", "null"] }
              }
            }
          },
          "wall_s": { "type": ["number", "null"] }
        }
      }
    }
  }
}
