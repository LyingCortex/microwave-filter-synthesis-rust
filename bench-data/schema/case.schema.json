{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FU filter-design benchmark case family",
  "description": "One file per family (an array of cases). spec/invariants are data; perf/gate_tols live in harness_config, not here.",
  "type": "object",
  "required": ["schema_version", "family", "cases"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "family": { "type": "string" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/case" } }
  },
  "definitions": {
    "case": {
      "type": "object",
      "required": ["id", "provenance", "spec", "invariants"],
      "properties": {
        "id": { "type": "string" },
        "provenance": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "spec": { "type": "object" },
        "invariants": { "type": "object" },
        "anchor_id": { "type": "string" }
      }
    }
  }
}
