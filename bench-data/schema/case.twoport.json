{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "filter-bench twoport case family",
  "description": "两端口黄金算例：Cameron 书例 + 其它独立来源。spec/invariants 的 family 特定约束在此；通用 envelope 见 case.schema.json。",
  "type": "object",
  "required": ["schema_version", "family", "cases"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "family": { "const": "twoport" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/case" } }
  },
  "definitions": {
    "case": {
      "type": "object",
      "required": ["id", "provenance", "spec", "invariants"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9_]*$" },
        "provenance": {
          "type": "object",
          "required": ["source"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "note": { "type": "string" }
          },
          "additionalProperties": false
        },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "spec": {
          "type": "object",
          "required": ["zeros"],
          "properties": {
            "order": { "type": ["integer", "null"], "minimum": 1 },
            "rl": { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "zeros": { "type": "array", "items": { "type": "number" } },
            "reflection_zeros": { "type": "array", "items": { "type": "number" } },
            "response": { "type": "string", "minLength": 1 },
            "goals": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "start", "stop", "value_db"],
                "properties": {
                  "type": { "enum": ["S11", "S21"] },
                  "start": { "type": "number" },
                  "stop": { "type": "number" },
                  "value_db": { "type": "number" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false,
          "if": { "required": ["response"], "properties": { "response": { "const": "Arbitrary" } } },
          "then": { "required": ["goals"] }
        },
        "invariants": {
          "type": "object",
          "required": ["n_ports"],
          "properties": {
            "n_total": { "type": ["integer", "null"], "minimum": 1 },
            "n_ports": { "const": 2 }
          },
          "additionalProperties": false
        },
        "anchor_id": { "type": "string", "minLength": 1 },
        "anchor": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
